# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=123456789:AAExampleTokenReplaceWithYourOwnFromBotFather

# Ma'lumotlar yuboriladigan guruh/kanal chat ID (masalan: -1001234567890)
# Botni guruhga admin qilib qo'shing, keyin ID ni shu yerga yozing
GROUP_CHAT_ID=

# --- Google Sheets (ixtiyoriy) ---
# To'ldirilsa, har bir ariza avtomatik Google Sheets'ga qator qilib qo'shiladi.
# Bo'sh qoldirilsa, Google Sheets integratsiyasi o'chiq bo'ladi.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
